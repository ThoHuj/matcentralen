# Kopiera till .env och fyll i.

# Nyckel från https://openrouter.ai/keys – behövs för att läsa in recept från länkar.
# Utan nyckel fungerar allt annat, men recept får skrivas in för hand.
OPENROUTER_API_KEY=

# Modellen som läser recepten. Vilken som helst från https://openrouter.ai/models går bra.
# anthropic/claude-haiku-5.5 är billigare och räcker ofta.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Discord-webhook dit förslag på ändringar av appen skickas ("Förslag" i menyn).
# Utan den visas inte knappen. Adressen är hemlig: alla som har den kan skriva i kanalen.
DISCORD_WEBHOOK_URL=

# Porten på servern där appen ska gå att nå.
PORT=3000
