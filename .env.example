# Kopiera till .env och fyll i.

# Nyckel från https://openrouter.ai/keys – behövs för att läsa in recept från länkar.
# Utan nyckel fungerar allt annat, men recept får skrivas in för hand.
OPENROUTER_API_KEY=

# Modellen som läser recepten. Vilken som helst från https://openrouter.ai/models går bra.
# anthropic/claude-haiku-5.5 är billigare och räcker ofta.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Discord-webhook dit förslag på ändringar av appen skickas ("Förslag" i menyn).
# Utan den visas inte knappen. Adressen är hemlig: alla som har den kan skriva i kanalen.
DISCORD_WEBHOOK_URL=

# Porten på servern där appen ska gå att nå (används inte med Tailscale-varianten nedan).
PORT=3000

# --- Tailscale (valfritt) ---
# Ta bort kommentaren för att köra appen som en egen maskin i ditt Tailscale-nät
# i stället för på en port på servern. Se "Run it on Tailscale" i README.
#COMPOSE_FILE=compose.tailscale.yml

# Nyckel från https://login.tailscale.com/admin/settings/keys. Behövs bara vid första
# starten och kan tas bort härifrån efteråt.
#TS_AUTHKEY=

# Namnet appen får i nätet: https://<namn>.<ditt-tailnet>.ts.net
#TS_HOSTNAME=matcentralen
